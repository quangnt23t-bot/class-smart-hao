{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the smart class system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["teacher", "student", "parent", "admin"] },
        "avatar": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Classroom entity managed by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "grade": { "type": "string", "maxLength": 64 },
        "subject": { "type": "string", "maxLength": 64 },
        "academicYear": { "type": "string", "maxLength": 32 },
        "room": { "type": "string", "maxLength": 64 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 128 },
        "totalStudents": { "type": "number" },
        "joinCode": { "type": "string", "maxLength": 32 },
        "themeColor": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "archived"] }
      },
      "required": ["id", "name", "grade", "subject", "teacherId"]
    },
    "Student": {
      "title": "Student",
      "description": "Student enrolled in school and classes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "gender": { "type": "string", "enum": ["Nam", "Nữ"] },
        "dob": { "type": "string", "maxLength": 32 },
        "avatar": { "type": "string", "maxLength": 512 },
        "phone": { "type": "string", "maxLength": 32 },
        "parentName": { "type": "string", "maxLength": 128 },
        "parentPhone": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "transferred", "suspended"] }
      },
      "required": ["id", "classId", "studentCode", "name"]
    },
    "Guardian": {
      "title": "Guardian",
      "description": "Parent or legal guardian of students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 128 },
        "guardianName": { "type": "string", "maxLength": 128 },
        "relationship": { "type": "string", "enum": ["Bố", "Mẹ", "Người giám hộ"] },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "studentId", "guardianName", "relationship", "phone"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "Standardized question in the Question Bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 5000 },
        "type": { "type": "string", "enum": ["single", "multiple", "true_false", "fill_blank", "mixed"] },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "expert"] },
        "subject": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "maxLength": 64 },
        "topic": { "type": "string", "maxLength": 256 },
        "explanation": { "type": "string", "maxLength": 5000 },
        "points": { "type": "number" },
        "sourceType": { "type": "string", "enum": ["file", "ai", "manual"] },
        "needsReview": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "question", "type", "difficulty", "subject", "grade"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework or exam task assigned to students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 5000 },
        "dueDate": { "type": "string", "maxLength": 64 },
        "assignedDate": { "type": "string", "maxLength": 64 },
        "maxScore": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published", "closed"] }
      },
      "required": ["id", "classId", "title", "dueDate", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily student attendance status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["present", "absent_excused", "absent_unexcused", "late"] },
        "note": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "classId", "studentId", "date", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "School or class wide announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 5000 },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderRole": { "type": "string", "maxLength": 64 },
        "target": { "type": "string", "enum": ["all", "class", "grade", "teachers"] },
        "targetClassId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "content", "priority"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles with role and basic contact info"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Stores classroom definitions and configurations"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Stores student profile data linked to classes"
    },
    "/guardians/{guardianId}": {
      "schema": { "$ref": "#/entities/Guardian" },
      "description": "Stores parent and guardian contact records"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/QuizQuestion" },
      "description": "Stores question bank questions created via AI, file, or manually"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Stores homework assignments and tests"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Stores daily attendance records"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Stores notices and announcements for classes and school"
    }
  }
}
